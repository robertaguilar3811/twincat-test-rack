<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(TcHmiDisableMSBuildWarningsAsMessages)'!='true'">
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TcHmiEnableFastUpToDateCheck)'!='true'">
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TcHmiDisableIncludeBuildOutput)'!='true'">
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TcHmiDisableDefaultPackageOutputPath)'!='true' AND '$(OS)'=='Windows_NT'">
    <PackageOutputPath Condition="'$(PackageOutputPath)'==''">$(ProgramData)\Beckhoff\NuGetPackages</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TcHmiDisableDefaultPackageIcon)'!='true'">
    <TcHmiDefaultPackageIconRelativePath>Images\logo.png</TcHmiDefaultPackageIconRelativePath>
    <TcHmiDefaultPackageIconAbsolutePath>$(ProjectDir)$(TcHmiDefaultPackageIconRelativePath)</TcHmiDefaultPackageIconAbsolutePath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageIcon Condition="Exists('$(TcHmiDefaultPackageIconAbsolutePath)')">$(TcHmiDefaultPackageIconAbsolutePath)</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(TcHmiDefaultPackageIconAbsolutePath)')">
    <None Include="$(TcHmiDefaultPackageIconAbsolutePath)">
      <Pack>True</Pack>
      <PackagePath>$(TcHmiDefaultPackageIconRelativePath)</PackagePath>
    </None>
  </ItemGroup>

</Project>
