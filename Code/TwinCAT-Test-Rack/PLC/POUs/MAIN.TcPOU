<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="MAIN" Id="{30c7193e-59f6-45c5-a509-33b386729a73}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	// Motors
	motor : ARRAY[1..GVL_MotorControl.CNUM_AXIS] OF ST_MotorParameters;
	i : INT;

	// Function blocks
	fbMotorControl : ARRAY[1..GVL_MotorControl.CNUM_AXIS] OF FB_MotorControl;

	// Init
	bInit : BOOL := FALSE;

	// State machine
	state : INT := 0;
	stateMessage : STRING;
	movesDone : BOOL := FALSE;

	// Lights
	greenLight, orangeLight, redLight AT %Q* : BOOL;

	// Switches
	sw1, sw2, sw3 AT %I* : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bInit THEN
	defaultParameters();
	bInit := TRUE;
END_IF

// Safety
IF NOT GVL_Safety.SafetyOutput THEN
	FOR i := 1 TO GVL_MotorControl.CNUM_AXIS DO
		motor[i].enable := FALSE;
	END_FOR
	state := 999;
END_IF

// Disable all motors if sw1 goes FALSE
IF NOT sw1 AND state <> 999 THEN
	FOR i := 1 TO GVL_MotorControl.CNUM_AXIS DO
		motor[i].enable := FALSE;
	END_FOR
	state := 0;
END_IF

GVL_Safety.SafetyRestart := sw3;
GVL_Safety.SafetyErrAck  := (state = 999 AND sw3);
GVL_Safety.SafetyRun     := TRUE;

FOR i := 1 TO GVL_MotorControl.CNUM_AXIS DO
	motor[i].executeReset := sw3;
END_FOR

// Home command — runs every scan regardless of state
IF sw2 AND state <> 999 THEN
	FOR i := 1 TO GVL_MotorControl.CNUM_AXIS DO
		motor[i].targetPosition := 0.0;
		motor[i].executeMoveAbsolute := TRUE;
	END_FOR
	state := 20;
END_IF

// Motor control
FOR i := 1 TO GVL_MotorControl.CNUM_AXIS DO
	fbMotorControl[i](
		axis := motor[i].axis,
		mode := motor[i].mode,
		enable := motor[i].enable,
		executeMoveAbsolute := motor[i].executeMoveAbsolute,
		executeMoveVelocity := motor[i].executeMoveVelocity,
		executeStop := motor[i].executeStop,
		executeReset := motor[i].executeReset,
		executeHome := motor[i].executeHome,
		executeSetPosition := motor[i].executeSetPosition,
		jogForward := motor[i].jogForward,
		jogBackwards := motor[i].jogBackwards,
		targetPosition := motor[i].targetPosition,
		targetVelocity := motor[i].targetVelocity,
		targetAcceleration := motor[i].targetAcceleration,
		minPosition := motor[i].minPosition,
		maxPosition := motor[i].maxPosition,
		stateMessage => motor[i].stateMessage,
		position => motor[i].position,
		velocity => motor[i].velocity,
		moveDone => motor[i].moveDone
		);
END_FOR

CASE state OF
	0: // Off
		stateMessage := 'OFF';
		FOR i := 1 TO GVL_MotorControl.CNUM_AXIS DO
			motor[i].executeMoveAbsolute := FALSE;
			motor[i].executeMoveVelocity := FALSE;
			motor[i].executeStop := FALSE;
		END_FOR
		IF sw1 THEN
			FOR i := 1 TO GVL_MotorControl.CNUM_AXIS DO
				motor[i].enable := TRUE;
			END_FOR
			state := 10;
		END_IF

	10: // Enabled, waiting for home command
		stateMessage := 'ENABLED';

	20: // Homing to position 0
		stateMessage := 'HOMING';
		FOR i := 1 TO GVL_MotorControl.CNUM_AXIS DO
			motor[i].executeMoveAbsolute := TRUE;
		END_FOR
		movesDone := TRUE;
		FOR i := 1 TO GVL_MotorControl.CNUM_AXIS DO
			IF NOT motor[i].moveDone THEN
				movesDone := FALSE;
			END_IF
		END_FOR
		IF movesDone THEN
			FOR i := 1 TO GVL_MotorControl.CNUM_AXIS DO
				motor[i].executeMoveAbsolute := FALSE;
			END_FOR
			state := 30;
		END_IF

	30: // Ready — HMI controls moves from here
		stateMessage := 'READY';

	999: // E-stop
		stateMessage := 'ESTOP';
		FOR i := 1 TO GVL_MotorControl.CNUM_AXIS DO
			motor[i].executeStop := TRUE;
		END_FOR
		IF GVL_Safety.SafetyOutput THEN
			FOR i := 1 TO GVL_MotorControl.CNUM_AXIS DO
				motor[i].executeStop := FALSE;
			END_FOR
			state := 0;
		END_IF

END_CASE

// Outputs
greenLight  := state = 30;
orangeLight := state = 10 OR state = 20;
redLight    := state = 999;]]></ST>
    </Implementation>
    <Action Name="defaultParameters" Id="{53611ac4-abe2-41cd-89b0-0c065352a0e0}">
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO GVL_MotorControl.CNUM_AXIS DO
	motor[i].targetVelocity := 100.0;
	motor[i].targetAcceleration := 69.0;
	motor[i].minPosition := -9999.0;
	motor[i].maxPosition := 9999.0;
END_FOR]]></ST>
      </Implementation>
    </Action>
